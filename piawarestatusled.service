[Unit]
Description=”Piaware Status LED Daemon"
After=multi-user.target

[Service]
Type=idle
Restart=always
WorkingDirectory=/home/pi/piawarestatusled
ExecStart=/home/pi/piawarestatusled/venv/bin/python3 /home/pi/piawarestatusled/piawarestatusled.py
StandardError=journal

[Install]
WantedBy=multi-user.target
